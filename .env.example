# ── Instagram ───────────────────────────────────────────────────────────────
INSTAGRAM_USERNAME=your_instagram_username
INSTAGRAM_PASSWORD=your_instagram_password

# ── Google Gemini API (free) ─────────────────────────────────────────────────
# Get free key at https://aistudio.google.com → "Get API Key"
GEMINI_API_KEY=AIza...

# ── Green API (WhatsApp) ─────────────────────────────────────────────────────
# Sign up free at https://green-api.com → create instance → scan QR with WhatsApp
GREENAPI_INSTANCE_ID=1234567890
GREENAPI_API_TOKEN=your_green_api_token

# Recipient WhatsApp number — digits only, with country code, no + or spaces
WHATSAPP_TO_NUMBER=919820839798
