# ── Instagram credentials (required for stories; posts/reels work without login) ──
INSTAGRAM_USERNAME=your_instagram_username
INSTAGRAM_PASSWORD=your_instagram_password

# ── Anthropic / Claude API ────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Twilio WhatsApp ───────────────────────────────────────────────────────────────
# Your Twilio Account SID and Auth Token (from https://console.twilio.com)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token

# The WhatsApp-enabled Twilio number (sandbox: +14155238886)
TWILIO_WHATSAPP_FROM=+14155238886

# Recipient WhatsApp number in E.164 format
WHATSAPP_TO_NUMBER=+919820839798
